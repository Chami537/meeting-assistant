# Local development only; never commit real secrets.
# Generate the password with `openssl rand -hex 24` (hex needs no URL escaping) and use it in both lines below.
# POSTGRES_PASSWORD only takes effect when the postgres_data volume is first initialised.
POSTGRES_PASSWORD=replace_me_with_long_random_password
DATABASE_URL=postgresql+asyncpg://meeting:replace_me_with_long_random_password@127.0.0.1:5433/meeting_assistant
REDIS_URL=redis://127.0.0.1:6380/0
APP_ENV=local
PUBLIC_BASE_URL=https://your-domain.example

# ---------- Offline mode (no GPU, no model account, no cloud): the quick way to run the whole loop ----------
# LLM_API=fake            # the extractive stand-in model (backend/app/integrations/fake_llm.py)
# ASR_PROVIDER=qwen       # pointed at a local service running ASR_ENGINE=fake (asr_service/fake_engine.py):
# ASR_QWEN_URL=http://127.0.0.1:8020
# STORAGE_BACKEND=local   # recordings as files; presigned links served by this API's /files route:
# LOCAL_STORAGE_DIR=./.local-storage
# LOCAL_STORAGE_SECRET=<openssl rand -hex 24>
# -----------------------------------------------------------------------------------------------------------

# ---------- Object storage ----------
# STORAGE_BACKEND=cos: Tencent Cloud COS. STORAGE_BACKEND=local: files under LOCAL_STORAGE_DIR, links signed
# with LOCAL_STORAGE_SECRET and served at LOCAL_STORAGE_URL (default PUBLIC_BASE_URL) by /files.
STORAGE_BACKEND=cos
LOCAL_STORAGE_DIR=
LOCAL_STORAGE_URL=
LOCAL_STORAGE_SECRET=
COS_REGION=
COS_BUCKET=
# Dev only: used to issue short-lived upload credentials to Workers; production uses roles/temporary credentials
COS_SECRET_ID=
COS_SECRET_KEY=

# ---------- WeCom (微信客服) intake; leave empty to disable ----------
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_ENCODING_AES_KEY=
WECOM_KF_OPEN_KFID=
# Servers calling qyapi must have a fixed public IPv4 listed in the app's 企业可信IP (else errcode 60020)
TMEETING_MODE=disabled
TMEETING_APP_ID=
TMEETING_SDK_ID=
TMEETING_SECRET_ID=
TMEETING_SECRET_KEY=
TMEETING_MCP_TOKEN=
# Tencent Meeting webhook credentials; never shared with the WeCom KF callback
TMEETING_WEBHOOK_TOKEN=
TMEETING_WEBHOOK_ENCODING_AES_KEY=

# ---------- Speech recognition ----------
# "whisper": a self-hosted faster-whisper job service (free, audio stays on your network, no speaker
# separation or punctuation); "qwen" / "funasr": the service in asr_service/ (speaker labels, optional
# sentence times); "tencent": 录音文件识别 (billed, separates speakers, punctuates; needs ASR_SECRET_*).
ASR_PROVIDER=whisper
ASR_SECRET_ID=
ASR_SECRET_KEY=
ASR_ENGINE_MODEL=16k_zh_en_meeting  # Tencent's multi-speaker meeting model
ASR_WHISPER_URL=
ASR_WHISPER_MODEL=faster-whisper-large-v3
ASR_WHISPER_LANGUAGE=zh
# Optional initial prompt; on Chinese meetings a punctuated prompt added stray symbols and repeated names
ASR_WHISPER_PROMPT=
ASR_QWEN_URL=
ASR_FUNASR_URL=
# Rolling 24h cap on audio submitted for recognition, per provider; jobs over the cap wait
ASR_DAILY_AUDIO_HOURS=24

# ---------- LLM ----------
# "openai": any OpenAI-compatible chat completions endpoint with JSON mode (LLM_BASE_URL ends before
# /chat/completions), e.g. DeepSeek. "anthropic": Claude via the official SDK with structured outputs
# (e.g. LLM_MODEL=claude-haiku-5-5, LLM_EFFORT=medium, LLM_MAX_OUTPUT_TOKENS=16000; LLM_BASE_URL / LLM_API_KEY
# may stay empty to use the ANTHROPIC_* environment). "fake": the offline stand-in, never for real minutes.
LLM_API=openai
LLM_EFFORT=medium
LLM_BASE_URL=
LLM_PROVIDER=
LLM_MODEL=
LLM_REGION=
LLM_API_KEY=
# Upper bound on the reply (max_tokens). Must not exceed the model's own output limit (many allow 8192; some
# allow only 4096), or every request is refused with HTTP 400; smoke checks it. 0 leaves it to the provider,
# whose default may be low (some use 1024) and truncate the minutes.
LLM_MAX_OUTPUT_TOKENS=8192
# Vendor-specific request fields as one-line JSON. DeepSeek thinks by default (slower, billed, ignores
# temperature); minutes need no reasoning: LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'
LLM_EXTRA_BODY=

# ---------- Security ----------
# Worker credentials are per-Worker tokens stored as hashes in worker_nodes.token_hash (no shared token).
# Key ring for application-level encryption: "<version>:<base64 32-byte key>" entries, comma-separated
DATA_ENCRYPTION_KEYS=1:replace_with_base64_32_byte_key
DATA_ENCRYPTION_ACTIVE_KEY=1

# ---------- The meetings page's jobs (/meeting/parse) ----------
# Kept in this SQLite file; unset and those endpoints answer 503. Recognition goes to ASR_QWEN_URL whatever
# ASR_PROVIDER says.
MEETING_PARSE_DB=
